# Copy this file to .env in the repository root. Never commit .env.
# Hosted model API (OpenAI-compatible). Free providers: groq, gemini, openrouter.
#   groq       key: https://console.groq.com/keys
#   gemini     key: https://aistudio.google.com/apikey
#   openrouter key: https://openrouter.ai/keys   (use a ":free" model)
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional overrides; each provider has a default base URL and model.
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_STATUS_TIMEOUT_SECONDS=10
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_RETRIES=3
# Agent mode is bounded by both a total task deadline and per-request timeout.
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=180
# Relative paths resolve from the project root. Uploaded files are private and Git-ignored.
EVOLVE_WORKSPACE_DIR=workspace
# SQLite initialization/migrations run at backend startup. Preserve this directory.
EVOLVE_DATA_DIR=data
HISTORY_MAX_MESSAGES=12
HISTORY_MAX_CHARS=5000
MEMORY_MAX_CHARS=1200
# Small UTF-8 file reads/reports; CSV analysis retains its separate upload limits.
WORKSPACE_MAX_BYTES=32768
WORKSPACE_MAX_FILES=100
UPLOAD_MAX_BYTES=1048576
CSV_MAX_ROWS=10000
CSV_MAX_COLUMNS=50
UPLOAD_MAX_FILES=50
# Phase 4: evidence is counted per distinct finished task, never per model claim.
IMPROVEMENT_MIN_EVIDENCE=3
CANDIDATE_MAX_TOKENS=2048
# Keep disabled unless a reviewed local Docker Desktop Linux image/runtime is available.
# No images are pulled. Image must be an immutable sha256:<64 hex> local image ID.
SANDBOX_ENABLED=false
SANDBOX_IMAGE=
SANDBOX_TIMEOUT_SECONDS=5
# Educational host subprocess execution, NOT a secure sandbox.
# Requires a second opt-in per agentic request (website demo checkbox / demo_tools=true).
DEMO_MODE=false
DEMO_TIMEOUT_SECONDS=5
AGENTIC_MAX_RECOVERIES=3
AGENTIC_BUILD_ATTEMPTS=2
# Vite's server-side proxy target. Restart Vite after changing it.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Excel limits and demo child memory cap (Windows).
XLSX_MAX_UNCOMPRESSED_BYTES=31457280
XLSX_MAX_SHEETS=20
DEMO_MEMORY_MB=256
GENERAL_TOOLS_MAX_PER_TASK=1

# Hosted deployments only: require this password before any API call (leave empty locally).
ACCESS_PASSWORD=
